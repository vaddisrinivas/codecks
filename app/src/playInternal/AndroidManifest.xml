<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <meta-data
            android:name="app.codecks.distribution"
            android:value="play_internal" />
        <meta-data
            android:name="app.codecks.commercial_policy"
            android:value="internal_test_capable" />
        <meta-data
            android:name="app.codecks.test_backend"
            android:value="${commercialTestBackendUrl}" />
        <activity
            android:name="io.codecks.internalcommercial.labui.CommercialLabActivity"
            android:exported="false"
            android:label="Codecks Commercial Lab"
            android:theme="@style/Theme.Codecks" />
        <activity
            android:name="io.codecks.ui.designsystem.M09ADesignTestActivity"
            android:exported="false"
            android:theme="@style/Theme.Codecks" />
        <activity
            android:name="io.codecks.internalquality.M11DexProxyActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Codecks" />
        <activity-alias
            android:name="io.codecks.internalcommercial.labui.CommercialLabLauncher"
            android:enabled="true"
            android:exported="true"
            android:label="Codecks Commercial Lab"
            android:targetActivity="io.codecks.internalcommercial.labui.CommercialLabActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- M16 is playInternal-only. DUMP restricts host control to adb shell/system. -->
        <service android:name="io.codecks.internalquality.m16.M16ProfileService01" android:exported="true" android:foregroundServiceType="specialUse" android:permission="android.permission.DUMP" android:process=":m16p01"><property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="internal autonomous reliability test" /></service>
        <service android:name="io.codecks.internalquality.m16.M16ProfileService02" android:exported="true" android:foregroundServiceType="specialUse" android:permission="android.permission.DUMP" android:process=":m16p02"><property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="internal autonomous reliability test" /></service>
        <service android:name="io.codecks.internalquality.m16.M16ProfileService03" android:exported="true" android:foregroundServiceType="specialUse" android:permission="android.permission.DUMP" android:process=":m16p03"><property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="internal autonomous reliability test" /></service>
        <service android:name="io.codecks.internalquality.m16.M16ProfileService04" android:exported="true" android:foregroundServiceType="specialUse" android:permission="android.permission.DUMP" android:process=":m16p04"><property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="internal autonomous reliability test" /></service>
        <service android:name="io.codecks.internalquality.m16.M16ProfileService05" android:exported="true" android:foregroundServiceType="specialUse" android:permission="android.permission.DUMP" android:process=":m16p05"><property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="internal autonomous reliability test" /></service>
        <provider
            android:name="io.codecks.internalquality.m16.M16EvidenceProvider"
            android:authorities="app.codecks.internal.m16evidence"
            android:exported="true"
            android:process=":m16evidence"
            android:readPermission="android.permission.DUMP" />
        <activity
            android:name="io.codecks.internalquality.m16.M16FailureEvidenceActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":m16evidence"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Codecks" />
    </application>
</manifest>
