{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codecks.autonomous-maturity.m09-current-source-census.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceCommit", "baseline", "method", "targetPublicProductionLines", "summary", "publicProduction", "boundaries", "files", "receiptDigest"],
  "properties": {
    "schema": {"const": "codecks.autonomous-maturity.m09-current-source-census.v1"},
    "sourceCommit": {"$ref": "#/$defs/commit"},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["commit", "inventorySha256", "summary"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "inventorySha256": {"$ref": "#/$defs/sha"}, "summary": {"type": "object"}}},
    "method": {"type": "object", "additionalProperties": false, "required": ["scope", "lineDefinition", "classification"], "properties": {"scope": {"type": "string"}, "lineDefinition": {"type": "string"}, "classification": {"type": "string"}}},
    "targetPublicProductionLines": {"const": 50000},
    "summary": {"type": "object", "additionalProperties": false, "required": ["fileCount", "physicalLines", "byCategory", "bySourceSet", "byLanguage"], "properties": {"fileCount": {"type": "integer", "minimum": 1}, "physicalLines": {"type": "integer", "minimum": 1}, "byCategory": {"$ref": "#/$defs/counts"}, "bySourceSet": {"$ref": "#/$defs/counts"}, "byLanguage": {"$ref": "#/$defs/counts"}}},
    "publicProduction": {"type": "object", "additionalProperties": false, "required": ["physicalLines", "excessLines", "featureOwnerLines", "featureOwnerReasons", "allLinesAssigned", "largestFile", "filesOver1000Lines"], "properties": {"physicalLines": {"type": "integer"}, "excessLines": {"type": "integer"}, "featureOwnerLines": {"$ref": "#/$defs/counts"}, "featureOwnerReasons": {"type": "object", "additionalProperties": {"type": "string", "minLength": 40}}, "allLinesAssigned": {"const": true}, "largestFile": {"type": "object", "additionalProperties": false, "required": ["path", "physicalLines"], "properties": {"path": {"type": "string"}, "physicalLines": {"type": "integer"}}}, "filesOver1000Lines": {"type": "array", "items": {"type": "string"}}}},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["codeCutForTarget", "startupMeasured", "apkMeasured", "deviceMeasured", "releaseAdmission"], "properties": {"codeCutForTarget": {"const": false}, "startupMeasured": {"const": false}, "apkMeasured": {"const": false}, "deviceMeasured": {"const": false}, "releaseAdmission": {"const": false}}},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "category", "sourceSet", "featureOwner", "language", "physicalLines", "sha256"], "properties": {"path": {"type": "string"}, "category": {"type": "string"}, "sourceSet": {"type": "string"}, "featureOwner": {"type": "string"}, "language": {"enum": ["Kotlin", "Java", "Swift"]}, "physicalLines": {"type": "integer"}, "sha256": {"$ref": "#/$defs/sha"}}}},
    "receiptDigest": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}
}
