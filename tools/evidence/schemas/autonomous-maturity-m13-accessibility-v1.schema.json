{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codecks.autonomous-maturity.m13-accessibility.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "milestone", "status", "repository", "proof_boundary", "managed_evidence", "unit_evidence", "unit_gradle_task", "required_unit_tests", "source_sha256", "test_source_sha256", "managed_execution"],
  "properties": {
    "schema": {"const": "codecks.autonomous-maturity.m13-accessibility.v1"},
    "schema_version": {"const": 3},
    "milestone": {"const": "M13"},
    "status": {"const": "PASS"},
    "repository": {"type": "object"},
    "proof_boundary": {"type": "object"},
    "managed_evidence": {"type": "object"},
    "unit_evidence": {"type": "array"},
    "unit_gradle_task": {"const": ":app:testPlayInternalReleaseUnitTest"},
    "required_unit_tests": {"type": "object"},
    "source_sha256": {"type": "object"},
    "test_source_sha256": {"type": "object"},
    "managed_execution": {"$ref": "#/$defs/binding"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "applicationId", "sha256"],
      "properties": {"path": {"type": "string"}, "applicationId": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceCommit", "sources", "sourceTreeSha256", "sourceDiffSha256", "result", "device", "targetApk", "testApk"],
      "properties": {
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sources": {"type": "array", "minItems": 1},
        "sourceTreeSha256": {"$ref": "#/$defs/digest"},
        "sourceDiffSha256": {"$ref": "#/$defs/digest"},
        "result": {"type": "object"},
        "device": {"type": "object"},
        "targetApk": {"$ref": "#/$defs/artifact"},
        "testApk": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
